{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 1,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "CSRF rotations / min (by service)",
      "id": 1,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "opsmin", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(csrf_rotations_total{service=~\"$service\"}[$__rate_interval])) * 60",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "stat",
      "title": "CSRF rotations / min (total, last 15m)",
      "id": 2,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "opsmin", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(csrf_rotations_total{service=~\"$service\"}[15m])) * 60",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "401→retry success % (by service)",
      "id": 3,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "100 * (sum by (service) (rate(api_fetch_retry_total{service=~\"$service\",outcome=\"success\"}[$__rate_interval])) / sum by (service) (rate(api_fetch_retry_total{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "stat",
      "title": "401→retry success % (total, last 15m)",
      "id": 4,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(api_fetch_retry_total{service=~\"$service\",outcome=\"success\"}[15m])) / sum(rate(api_fetch_retry_total{service=~\"$service\"}[15m])))",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Idempotency hit rate % of writes (by service)",
      "id": 5,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "100 * (sum by (service) (rate(idempotency_hits_total{service=~\"$service\"}[$__rate_interval])) / sum by (service) (rate(http_write_requests_total{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses in degraded mode % (by service)",
      "id": 6,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "100 * (sum by (service) (rate(http_responses_total{service=~\"$service\", degraded=\"1\"}[$__rate_interval])) / sum by (service) (rate(http_responses_total{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Write SLI (2xx / total) — last 15m",
      "id": 20,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "avg(api:writes_sli_pct:svc_env_cluster_region{service=~\"$service\", env=~\"$env\", cluster=~\"$cluster\", region=~\"$region\"}) or avg(api:writes_sli_pct:by_service_only{service=~\"$service\"})",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error budget burn × (5m/1h & 30m/6h)",
      "id": 21,
      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 30 },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 2, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 6 }, { "color": "red", "value": 14.4 }] } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "api:writes_burnrate:5m:svc_env_cluster_region{service=~\"$service\", env=~\"$env\", cluster=~\"$cluster\", region=~\"$region\"} or api:writes_burnrate:5m:by_service_only{service=~\"$service\"}",
          "legendFormat": "5m — {{service}}{{ if env }}/{{env}}{{ end }}{{ if cluster }}/{{cluster}}{{ end }}{{ if region }}/{{region}}{{ end }}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        },
        {
          "expr": "api:writes_burnrate:1h:svc_env_cluster_region{service=~\"$service\", env=~\"$env\", cluster=~\"$cluster\", region=~\"$region\"} or api:writes_burnrate:1h:by_service_only{service=~\"$service\"}",
          "legendFormat": "1h — {{service}}{{ if env }}/{{env}}{{ end }}{{ if cluster }}/{{cluster}}{{ end }}{{ if region }}/{{region}}{{ end }}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        },
        {
          "expr": "api:writes_burnrate:30m:svc_env_cluster_region{service=~\"$service\", env=~\"$env\", cluster=~\"$cluster\", region=~\"$region\"} or api:writes_burnrate:30m:by_service_only{service=~\"$service\"}",
          "legendFormat": "30m — {{service}}{{ if env }}/{{env}}{{ end }}{{ if cluster }}/{{cluster}}{{ end }}{{ if region }}/{{region}}{{ end }}",
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        },
        {
          "expr": "api:writes_burnrate:6h:svc_env_cluster_region{service=~\"$service\", env=~\"$env\", cluster=~\"$cluster\", region=~\"$region\"} or api:writes_burnrate:6h:by_service_only{service=~\"$service\"}",
          "legendFormat": "6h — {{service}}{{ if env }}/{{env}}{{ end }}{{ if cluster }}/{{cluster}}{{ end }}{{ if region }}/{{region}}{{ end }}",
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Est. Error Budget Remaining (rolling 30d)",
      "id": 22,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(http_responses_total{method=~\"POST|PUT|PATCH|DELETE\",code!~\"2..\",service=~\"$service\",env=~\"$env\",cluster=~\"$cluster\",region=~\"$region\"}[30d])) / sum(rate(http_responses_total{method=~\"POST|PUT|PATCH|DELETE\",service=~\"$service\",env=~\"$env\",cluster=~\"$cluster\",region=~\"$region\"}[30d])))) or 100 * (1 - (sum(rate(http_responses_total{method=~\"POST|PUT|PATCH|DELETE\",code!~\"2..\",service=~\"$service\"}[30d])) / sum(rate(http_responses_total{method=~\"POST|PUT|PATCH|DELETE\",service=~\"$service\"}[30d]))))",
          "refId": "A",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["security", "api", "csrf", "idempotency", "reliability", "slo"],
  "templating": {
