# Production Security Configuration Template
# Copy this to your production environment and fill in the values

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Use RS256 or EdDSA in production for better key management
JWT_ALG=RS256
# For RS256/EdDSA, provide PEM-formatted keys
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
# For HS256 (development only), use a strong secret
JWT_SECRET="your-super-secure-jwt-secret-at-least-32-characters-long"
# Token lifetimes
JWT_REFRESH_TTL_DAYS=30
JWT_ACCESS_TTL_MIN=15
JWT_LEEWAY_SEC=30

# =============================================================================
# COOKIE CONFIGURATION
# =============================================================================
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=Strict
COOKIE_HTTPONLY=true

# =============================================================================
# CSRF CONFIGURATION
# =============================================================================
CSRF_SECRET="your-super-secure-csrf-secret-at-least-32-characters-long"
CSRF_ROTATE_ON_LOGIN=true
CSRF_ROTATE_ON_LOGOUT=true

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_REDIS_URL=redis://your-redis-host:6379/0
# JSON configuration for rate limits
RATE_LIMITS_JSON={"default":"100/m","/auth/":"10/m","/admin/":"5/m","/2fa/":"5/m"}

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_MAX_BYTES=10485760
UPLOAD_IMAGE_MAX_W=8192
UPLOAD_IMAGE_MAX_H=8192
UPLOAD_PDF_MAX_PAGES=50
UPLOAD_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,pdf,zip
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf,application/zip

# =============================================================================
# SSRF PROTECTION
# =============================================================================
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOWED_DOMAINS=yourdomain.com,api.yourdomain.com
SSRF_MAX_REDIRECTS=3

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Content Security Policy
CSP_REPORT_URI=https://yourdomain.com/csp-report
CSP_REPORT_ONLY=false
# HSTS (only in production)
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
SECURITY_EVENT_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SECURITY_LOG_LEVEL=WARNING
SECURITY_LOG_FORMAT=json
# SIEM integration
SIEM_ENDPOINT=https://your-siem.com/api/events
SIEM_API_KEY=your-siem-api-key

# =============================================================================
# DATABASE SECURITY
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# REDIS SECURITY
# =============================================================================
REDIS_URL=redis://user:password@host:6379/0
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true
REDIS_SSL_CERT_REQS=required

# =============================================================================
# APPLICATION SECURITY
# =============================================================================
# Environment
ENVIRONMENT=production
# Base URL (must be HTTPS in production)
PUBLIC_BASE_URL=https://yourdomain.com
# API Secret for general use
API_SECRET_KEY="your-super-secure-api-secret-at-least-32-characters-long"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/shomer/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
# PII redaction
LOG_REDACT_PII=true
LOG_MAX_BODY_SIZE=2048

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key"

# =============================================================================
# COMPLIANCE & AUDIT
# =============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
AUDIT_LOG_ENCRYPTION=true
COMPLIANCE_MODE=strict

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_2FA=true
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true
ENABLE_SECURITY_HEADERS=true
ENABLE_FILE_VALIDATION=true
ENABLE_SSRF_PROTECTION=true
ENABLE_AUDIT_LOGGING=true

# =============================================================================
# DEVELOPMENT OVERRIDES (DO NOT USE IN PRODUCTION)
# =============================================================================
# DEBUG=false
# RELOAD=false
# WORKERS=4
# BIND=0.0.0.0:8000
