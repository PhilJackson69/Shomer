  "alerts": [
    {
      "name": "High 5xx Error Rate",
      "message": "5xx error rate exceeds 1%",
      "conditions": [
        {
          "evaluator": {
            "type": "gt",
            "params": [0.01]
          },
          "operator": {
            "type": "and"
          },
          "query": {
            "params": ["A", "5m", "now"]
          },
          "reducer": {
            "type": "avg"
          },
          "type": "query"
        }
      ],
      "executionErrorState": "alerting",
      "frequency": "1m",
      "handler": 1,
      "noDataState": "no_data",
      "notifications": []
    },
    {
      "name": "Verification Failures Spike",
      "message": "More than 10 verification failures in 10 minutes",
      "conditions": [
        {
          "evaluator": {
            "type": "gt",
            "params": [10]
          },
          "operator": {
            "type": "and"
          },
          "query": {
            "params": ["A", "10m", "now"]
          },
          "reducer": {
            "type": "sum"
          },
          "type": "query"
        }
      ],
      "executionErrorState": "alerting",
      "frequency": "1m",
