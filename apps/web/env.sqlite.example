# Minimal environment for SQLite development
# Copy this to .env and update values as needed

CRON_SECRET=dev-cron-secret
INCIDENT_SLA_MINUTES=1

# Optional nice-to-haves:
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
SLACK_MIN_LEVEL=HIGH

# If your code still reads DATABASE_URL at runtime, you can point it to SQLite too:
# DATABASE_URL="file:dev.db"

# Additional required fields for the app to work
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ACTION_SECRET=dev-action-secret-min-16-chars
REDIS_URL=redis://localhost:6379
