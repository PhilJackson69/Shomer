{
  "name": "@shomer/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema ./prisma/schema.prisma || true",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:gen:sqlite": "prisma generate --schema ./prisma/schema.sqlite.prisma",
    "db:mig:sqlite": "prisma migrate dev --name init_sqlite --schema ./prisma/schema.sqlite.prisma",
    "db:studio:sqlite": "prisma studio --schema ./prisma/schema.sqlite.prisma",
    "seed:oncall": "tsx scripts/seed-oncall.ts",
    "seed:badwh": "tsx scripts/seed-bad-webhook.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "e2e": "start-server-and-test dev http://localhost:3000 cypress",
    "test": "vitest run",
    "test:pw": "playwright test",
    "ci:dev-redis-off": "cross-env USE_REDIS=false vitest run -t 'Dev without Redis'",
    "backfill:org": "tsx scripts/backfill-org.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:threat": "tsx scripts/seed-threat-detection.ts",
    "workers:threat": "tsx scripts/start-threat-detection-workers.ts",
    "replay:fixtures": "tsx scripts/replay-threat-fixtures.ts",
    "assert:replay": "tsx scripts/assert-replay.ts",
    "ci:replay": "pnpm prisma db push && pnpm replay:fixtures && pnpm assert:replay",
    "maint:retention": "tsx scripts/retention.ts",
    "maint:index": "tsx scripts/index_maint.ts",
    "maint:nightly": "pnpm maint:index && pnpm maint:retention"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@shomer/shared": "workspace:*",
    "@tanstack/react-query": "^5.17.19",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "ioredis": "^5.4.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.307.0",
    "mapbox-gl": "^3.5.2",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.49.3",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "xml2js": "^0.6.2",
    "yaml": "^2.5.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "cypress": "^13.6.3",
    "eslint": "^8",
    "eslint-config-next": "^15.0.0",
    "globby": "^15.0.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^27.0.0",
    "postcss": "^8",
    "prisma": "^6.18.0",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.16.0",
    "typescript": "^5",
    "vitest": "^2.1.3"
  }
}
