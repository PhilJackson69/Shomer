# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shomer

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# API
API_V1_STR=/api/v1

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Retention Configuration
TIP_RETENTION_DAYS=14
ENABLE_RETENTION_SCHEDULER=true

# Alert Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com

# Environment
ENVIRONMENT=development  # development or production

# NLP (Optional)
ENABLE_ML_MODELS=false  # Set to true to enable HuggingFace models
NLP_MODEL=distilbert-base-uncased

# Ingestion
INGESTION_SCHEDULE_INTERVAL=3600  # seconds

# Feature Flags
FEATURE_EVIDENCE=true  # Enable evidence submission and chain-of-custody tracking
FEATURE_NLP=false  # Enable NLP classification for tips

# Evidence Storage
STORAGE_LOCAL_PATH=./storage  # Local path for evidence file storage
STORAGE_TYPE=local  # local or s3