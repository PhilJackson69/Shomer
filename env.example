# Shomer v1 Environment Configuration
# 
# SECURITY NOTE: Generate strong secrets for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or: python -m app.core.security generate

# Database Configuration
POSTGRES_USER=shomer
POSTGRES_PASSWORD=shomer
POSTGRES_DB=shomer
DATABASE_URL=postgresql://shomer:shomer@localhost:5432/shomer

# Supabase Configuration (Optional - for advanced features)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Configuration - CRITICAL SECURITY SETTINGS
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=devsecret_change_me_in_production
JWT_SECRET=devjwt_change_me_in_production
JWT_EXPIRES_IN=3600

# Signed URL Security (for secure file access)
SIGNED_URL_SECRET=dev_change_me
SIGNED_URL_DEFAULT_TTL_SECONDS=600

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# External Service Configuration (Optional)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ShomerBot/1.0

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# NLP Service Configuration
NLP_SERVICE_URL=http://localhost:8001

# Application URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# Public Base URL (for signed URLs and CORS)
# In production, MUST use HTTPS and real domain
PUBLIC_BASE_URL=http://localhost:8000

# Environment (development/production)
ENVIRONMENT=development

# Web Origin (for CORS in production)
WEB_ORIGIN=

# Feature Flags
FEATURE_EVIDENCE=false
FEATURE_2FA=false

# Retention Settings
TIP_RETENTION_DAYS=14
ENABLE_RETENTION_SCHEDULER=true

# Observability (Optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=shomer-api

# Git SHA (for deployment tracking)
GIT_SHA=